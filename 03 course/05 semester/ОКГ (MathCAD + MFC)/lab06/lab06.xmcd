		<region region-id="262" left="18" top="838.5" width="476.25" height="45.75" align-x="46.5" align-y="864" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">V_xy</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:id xml:space="preserve">stack</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:transpose/>
									<ml:apply>
										<ml:matcol/>
										<ml:parens>
											<ml:apply>
												<ml:transpose/>
												<ml:id xml:space="preserve">V_Coords</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:real>0</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:transpose/>
									<ml:apply>
										<ml:matcol/>
										<ml:parens>
											<ml:apply>
												<ml:transpose/>
												<ml:id xml:space="preserve">V_Coords</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:matrix rows="1" cols="6">
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
								</ml:matrix>
							</ml:sequence>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="3" cols="6">
								<ml:real>3.5355339059327386</ml:real>
								<ml:real>-2.4999999999999996</ml:real>
								<ml:real>1</ml:real>
								<ml:real>0</ml:real>
								<ml:real>0</ml:real>
								<ml:real>1</ml:real>
								<ml:real>3.5355339059327369</ml:real>
								<ml:real>2.5000000000000004</ml:real>
								<ml:real>1</ml:real>
								<ml:real>0.70710678118654768</ml:real>
								<ml:real>3.0355339059327373</ml:real>
								<ml:real>1</ml:real>
								<ml:real>0</ml:real>
								<ml:real>3.5355339059327373</ml:real>
								<ml:real>1</ml:real>
								<ml:real>0.70710678118654735</ml:real>
								<ml:real>4.0355339059327378</ml:real>
								<ml:real>1</ml:real>
